{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextHive",
  "version": "0.1.1",
  "identifier": "com.nexthive.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NextHive",
        "width": 1160,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "devtools": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "VoiLabs",
    "homepage": "https://voilabs.com",
    "copyright": "Copyright © 2026 VoiLabs. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMUEzQkYxMjk5MTNGQzUKUldURlA1RXA4VHNhdTVvTExvVFJLb2xUamVwUDIvYVdQUlF0Y09OMHpSVW9Xb3k5UTRYbnVpVzUK",
      "endpoints": [
        "https://github.com/voilabs/nexthive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
